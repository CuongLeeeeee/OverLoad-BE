{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\mssqllocaldb;Database=OverLoadDb_Dev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "SecretKey": "YOUR_SECRET_KEY_MIN_32_CHARS_HERE",
    "Issuer": "OverLoadAPI",
    "Audience": "OverLoadClient",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-2.5-flash",
    "MaxOutputTokens": 2048,
    "Temperature": 0.7
  },
  "PayOS": {
    "ClientId": "YOUR_PAYOS_CLIENT_ID",
    "ApiKey": "YOUR_PAYOS_API_KEY",
    "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY"
  },
  "Payment": {
    "FrontendBaseUrl": "http://localhost:3000",
    "ReturnPath": "/payment/success",
    "CancelPath": "/payment/cancel",
    "ProMonthPrice": 69000,
    "ProYearPrice": 599000,
    "MinDepositAmount": 10000,
    "MaxDepositAmount": 50000000
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
