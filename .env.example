# Copy to .env for docker compose. .env is git-ignored — never commit real values.

# Password of the local PostgreSQL container
DB_PASSWORD=local-dev-password

# At least 32 characters
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more

GEMINI_API_KEY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

FRONTEND_BASE_URL=http://localhost:3000

# One-off data transfer (tools/OverLoad.DataTransfer): the old SQL Server database, read only
SOURCE_SQLSERVER_CONNECTION=
