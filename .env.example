# Copy to .env for docker compose. .env is git-ignored — never commit real values.

# SQL Server "sa" password for the local container (8+ chars, upper, lower, digit, symbol)
DB_SA_PASSWORD=Local_Dev_Pa55word!

# At least 32 characters
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more

GEMINI_API_KEY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

FRONTEND_BASE_URL=http://localhost:3000
